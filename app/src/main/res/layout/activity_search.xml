<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <!-- ── Top Bar ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:baselineAligned="false"
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2563EB"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Shield icon -->
        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Search icon"
            android:src="@drawable/ic_search_header"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Search &amp; Filter"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <!-- Exit/back arrow -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Back"
            android:src="@drawable/ic_logout"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- ── Search + Date + Filter row ────────────────────────────────────── -->
    <LinearLayout
        android:baselineAligned="false"
        android:id="@+id/row_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- Text search field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_search"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="#E5E7EB"
            app:boxStrokeWidth="1dp"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search_modern"
            app:startIconTint="#9CA3AF">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search Order, Customer, Driver..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date picker + Filter icon row -->
        <LinearLayout
        android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Date picker button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_date"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Calendar"
                        android:src="@drawable/ic_calendar"
                        app:tint="#6B7280" />

                    <TextView
                        android:id="@+id/edit_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:hint="Select date"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btn_clear_date"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear date"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="#9CA3AF" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Filter icon button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_filter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="Filter"
                    android:src="@drawable/ic_filter"
                    app:tint="#6B7280" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

    <!-- ── Results count ─────────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tv_results_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="All deliveries"
        android:textColor="#6B7280"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/row_search" />

    <!-- ── Results list ───────────────────────────────────────────────────── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="72dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tv_results_count"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav" />

    <!-- ── Empty state ────────────────────────────────────────────────────── -->
    <LinearLayout
        android:baselineAligned="false"
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_results_count"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <ImageView
        android:contentDescription="@null"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_search_modern"
            app:tint="#D1D5DB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No results found"
            android:textColor="#6B7280"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Try a different name, order ID or city"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ── Bottom Navigation ─────────────────────────────────────────────── -->
    <LinearLayout
        android:baselineAligned="false"
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Dashboard tab -->
        <LinearLayout
        android:baselineAligned="false"
            android:id="@+id/tab_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
        android:contentDescription="@null"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_dashboard_modern"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Dashboard"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Search tab — ACTIVE -->
        <LinearLayout
        android:baselineAligned="false"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
        android:contentDescription="@null"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search_modern"
                app:tint="#2563EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Search"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Hub tab -->
        <LinearLayout
        android:baselineAligned="false"
            android:id="@+id/tab_hub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
        android:contentDescription="@null"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_hub_modern"
                app:tint="#9CA3AF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Hub"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>