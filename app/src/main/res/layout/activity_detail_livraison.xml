<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dinex_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dinex_dark">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:title="Delivery Details"
            app:titleTextColor="@color/dinex_text_primary"
            app:navigationIcon="@drawable/ic_logout"
            app:navigationIconTint="@color/dinex_text_secondary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Client Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/dinex_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/dinex_gray_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLIENT INFORMATION"
                        android:textColor="@color/dinex_coral"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/detail_nom_client"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Bob Johnson"
                        android:textColor="@color/dinex_text_primary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/detail_tel_client"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="+33 6 12 34 56 78"
                        android:textColor="@color/dinex_text_secondary"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/dinex_gray_light" />

                    <TextView
                        android:id="@+id/detail_adresse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="123 Main St, Apartment 4B, Lyon"
                        android:textColor="@color/dinex_text_primary"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_google_maps"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Navigate in Google Maps"
                        android:textAllCaps="false"
                        android:textColor="@color/dinex_text_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_location"
                        app:iconTint="@color/dinex_coral"
                        app:strokeColor="@color/dinex_gray_light" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_call_client"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Call Client"
                        android:textAllCaps="false"
                        android:textColor="@color/dinex_text_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_phone"
                        app:iconTint="@color/dinex_coral"
                        app:strokeColor="@color/dinex_gray_light" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Order Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/dinex_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/dinex_gray_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ORDER DETAILS"
                        android:textColor="@color/dinex_coral"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/detail_id_cmd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Commande #ORD-1001"
                        android:textColor="@color/dinex_text_primary"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/detail_articles"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="3 articles"
                        android:textColor="@color/dinex_text_secondary"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/dinex_gray_light" />

                    <LinearLayout
                        android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:baselineAligned="false"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/detail_montant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="150.00 DT"
                                android:textColor="@color/dinex_coral"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/detail_paiement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Payment: CASH"
                                android:textColor="@color/dinex_text_secondary"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_modifier"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Update Delivery Status"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                app:backgroundTint="@color/dinex_coral"
                app:cornerRadius="16dp"
                android:elevation="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_detail_urgence"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:text="Report Urgent Problem"
                android:textAllCaps="false"
                android:textColor="@color/dinex_coral"
                android:textSize="15sp"
                app:icon="@drawable/ic_shield_alert"
                app:iconTint="@color/dinex_coral" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
