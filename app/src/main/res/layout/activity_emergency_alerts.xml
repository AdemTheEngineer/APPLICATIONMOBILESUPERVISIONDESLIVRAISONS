<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dinex_background">

    <!-- ── App Bar ────────────────────────────────────────────────────────── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dinex_dark"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/dinex_dark"
            app:contentInsetStart="16dp">

            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Emergency Alerts Icon"
                    android:src="@drawable/ic_shield_alert"
                    app:tint="@color/dinex_coral" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-black"
                    android:text="EMERGENCY ALERTS"
                    android:letterSpacing="0.1"
                    android:textColor="@color/dinex_text_primary"
                    android:textSize="18sp" />

                <ImageButton
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/dinex_text_secondary" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Driver + Date sub-header -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/dinex_gray_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/tv_driver_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Driver: —"
                android:textColor="@color/dinex_coral"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/dinex_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Scrollable content ─────────────────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="100dp">

            <!-- ── Emergency Alert Banner ──────────────────────────────────── -->
            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_alert_banner"
                android:backgroundTint="@color/dinex_gray_dark"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Warning"
                        android:src="@drawable/ic_warning_triangle"
                        app:tint="@color/dinex_coral" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="URGENT ACTIONS"
                        android:textColor="@color/dinex_coral"
                        android:textSize="15sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Select an option below to instantly notify the control center of critical issues."
                    android:textColor="@color/dinex_text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

            <!-- ── QUICK ALERTS label ──────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="QUICK ALERTS"
                android:textColor="@color/dinex_text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_vehicle_breakdown"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Vehicle Breakdown"
                android:textAllCaps="false"
                android:textColor="@color/dinex_text_primary"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="end"
                app:iconTint="@color/dinex_gray_light"
                app:strokeColor="@color/dinex_gray_light"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_customer_not_responding"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Customer Not Responding"
                android:textAllCaps="false"
                android:textColor="@color/dinex_text_primary"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="end"
                app:iconTint="@color/dinex_gray_light"
                app:strokeColor="@color/dinex_gray_light"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_incorrect_address"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:text="Incorrect Address"
                android:textAllCaps="false"
                android:textColor="@color/dinex_text_primary"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="end"
                app:iconTint="@color/dinex_gray_light"
                app:strokeColor="@color/dinex_gray_light"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_heavy_traffic"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="28dp"
                android:text="Heavy Traffic Delay"
                android:textAllCaps="false"
                android:textColor="@color/dinex_text_primary"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="end"
                app:iconTint="@color/dinex_gray_light"
                app:strokeColor="@color/dinex_gray_light"
                app:strokeWidth="1dp" />

            <!-- ── CUSTOM ALERT label ──────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="CUSTOM ALERT"
                android:textColor="@color/dinex_text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_custom_alert"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="@color/dinex_dark"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/dinex_gray_light"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_custom_alert"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="Describe the issue in detail..."
                    android:inputType="textMultiLine"
                    android:padding="16dp"
                    android:textColor="@color/dinex_text_primary"
                    android:textColorHint="@color/dinex_text_secondary"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Send Custom Alert button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_send_custom_alert"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="32dp"
                android:enabled="false"
                android:text="Send Alert"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/dinex_gray_light"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <!-- ── Need Direct Support card ────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dinex_gray_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:baselineAligned="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Need direct support?"
                            android:textColor="@color/dinex_text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Call dispatch center immediately"
                            android:textColor="@color/dinex_coral"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_call_dispatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Call Dispatch"
                        android:src="@drawable/ic_phone"
                        app:backgroundTint="@color/dinex_coral"
                        app:elevation="2dp"
                        app:fabSize="mini"
                        app:tint="@color/white" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom Navigation ───────────────────────────────────────────────── -->
    <LinearLayout
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/dinex_dark"
        android:elevation="16dp"
        android:orientation="horizontal">

        <!-- Schedule tab -->
        <LinearLayout
            android:baselineAligned="false"
            android:id="@+id/nav_schedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/dinex_text_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Schedule"
                android:textColor="@color/dinex_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Alerts tab — ACTIVE -->
        <LinearLayout
            android:baselineAligned="false"
            android:id="@+id/nav_alerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                app:tint="@color/dinex_coral" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Alerts"
                android:textColor="@color/dinex_coral"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Hub tab -->
        <LinearLayout
            android:baselineAligned="false"
            android:id="@+id/nav_hub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_hub"
                app:tint="@color/dinex_text_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hub"
                android:textColor="@color/dinex_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>