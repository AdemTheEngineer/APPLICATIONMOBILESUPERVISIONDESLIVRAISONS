<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Bar -->
    <LinearLayout
        android:baselineAligned="false"
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#2563EB"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
        android:contentDescription="@null"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_dialog_dialer"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tv_dashboard_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Dashboard"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_exit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="@android:color/white"
            android:contentDescription="Logout" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <LinearLayout
        android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginHorizontal="-6dp">
                
                <!-- Pending Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB">
                    <LinearLayout
        android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="#FEF3C7"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
        android:contentDescription="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp"
                                android:src="@android:drawable/ic_menu_recent_history"
                                app:tint="#F59E0B" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
        android:baselineAligned="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PENDING"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />
                            <TextView
                                android:id="@+id/tv_pending_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#111827" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- In Transit Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB">
                    <LinearLayout
        android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="#DBEAFE"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
        android:contentDescription="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp"
                                android:src="@android:drawable/ic_menu_send"
                                app:tint="#3B82F6" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
        android:baselineAligned="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IN TRANSIT"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />
                            <TextView
                                android:id="@+id/tv_transit_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#111827" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Delivered Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB">
                    <LinearLayout
        android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="#D1FAE5"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
        android:contentDescription="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="#10B981" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
        android:baselineAligned="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DELIVERED"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />
                            <TextView
                                android:id="@+id/tv_delivered_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#111827" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Failed Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E5E7EB">
                    <LinearLayout
        android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardCornerRadius="18dp"
                            app:cardBackgroundColor="#FEE2E2"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">
                            <ImageView
        android:contentDescription="@null"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp"
                                android:src="@android:drawable/stat_notify_error"
                                app:tint="#EF4444" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
        android:baselineAligned="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FAILED"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#6B7280" />
                            <TextView
                                android:id="@+id/tv_failed_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#111827" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <!-- Status Distribution -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E7EB">
                <LinearLayout
        android:baselineAligned="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="STATUS DISTRIBUTION"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="24dp"/>
                    
                    <!-- Real donut chart drawn from live status data -->
                    <com.example.applicationmobilesupervisiondeslivraisons.views.DonutChartView
                        android:id="@+id/donut_chart"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center" />
                    
                    <LinearLayout
        android:baselineAligned="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="24dp">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/circle_shape" android:backgroundTint="#F59E0B" android:layout_marginEnd="6dp" android:layout_gravity="center_vertical"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="16dp"/>
                        
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/circle_shape" android:backgroundTint="#3B82F6" android:layout_marginEnd="6dp" android:layout_gravity="center_vertical"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="In Transit" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="16dp"/>

                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/circle_shape" android:backgroundTint="#10B981" android:layout_marginEnd="6dp" android:layout_gravity="center_vertical"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delivered" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold" android:layout_marginEnd="16dp"/>

                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/circle_shape" android:backgroundTint="#EF4444" android:layout_marginEnd="6dp" android:layout_gravity="center_vertical"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Failed" android:textColor="#111827" android:textSize="12sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Deliveries -->
            <LinearLayout
        android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active Deliveries"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#3B82F6"/>
            </LinearLayout>

            <!-- The list wrapper to add spacing around cells -->
            <LinearLayout
        android:baselineAligned="false" 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-6dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_deliveries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-10dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav -->
    <LinearLayout
        android:baselineAligned="false"
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:elevation="16dp">

        <!-- Dashboard tab — already active, no navigation needed -->
        <LinearLayout
        android:baselineAligned="false"
            android:id="@+id/tab_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
        android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_mylocation"
                app:tint="#3B82F6" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#3B82F6"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Search tab -->
        <LinearLayout
        android:baselineAligned="false"
            android:id="@+id/tab_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
        android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#9CA3AF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Hub tab -->
        <LinearLayout
        android:baselineAligned="false"
            android:id="@+id/tab_hub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <ImageView
        android:contentDescription="@null"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#9CA3AF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hub"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>
    
</androidx.constraintlayout.widget.ConstraintLayout>