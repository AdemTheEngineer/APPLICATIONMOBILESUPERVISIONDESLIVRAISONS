<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_message_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Sender + timestamp label -->
    <TextView
        android:id="@+id/text_sender_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:text="ADMIN • 09:53 PM"
        android:textColor="@color/dinex_text_secondary"
        android:textSize="11sp"
        android:textAllCaps="true" />

    <!-- Message bubble -->
    <TextView
        android:id="@+id/text_message_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Message text here"
        android:textColor="@color/dinex_text_primary"
        android:lineSpacingExtra="2dp"
        android:textSize="15sp"
        android:background="@drawable/bg_bubble_driver"
        android:elevation="2dp" />

</LinearLayout>